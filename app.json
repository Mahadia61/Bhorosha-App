{
  "expo": {
    "name": "Bhorosha",
    "slug": "bhorosha",
    "scheme": "bhorosha",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bhorosha to choose a profile photo."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "ac.cuet.bhorosha"
    },
    "ios": {
      "bundleIdentifier": "ac.cuet.bhorosha"
    }
  }
}
