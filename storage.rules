rules_version = '2';

// This project intentionally stays on the Firebase Spark plan. Firebase Storage
// is not configured or deployed; teacher profile images use the separate backend
// and external image host. Deny all writes if this file is accidentally deployed.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
